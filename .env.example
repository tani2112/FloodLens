# FloodLens Environment Configuration Example

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_USER=floodlens
POSTGRES_PASSWORD=floodlens_secret
POSTGRES_DB=floodlens_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://floodlens:floodlens_secret@localhost:5432/floodlens_db

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DEMO_MODE=true
